{
  "$schema": "https://antigravity.google/schemas/v1/agyloop.json",
  "models": {
    "planner": "pro",
    "implementer": "inherit",
    "gate": "flash_lite",
    "reviewer": "flash"
  },
  "options": {
    "commitAfter": false,
    "gateTimeoutSeconds": 60,
    "autoApproveInYolo": true,
    "enableMcpInPlanner": true,
    "gateCommands": [
      {
        "id": "bash-unit-tests",
        "label": "Bash Unit Tests",
        "command": "bash tests/test-tag-engine.sh"
      }
    ]
  }
}
